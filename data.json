<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Power Electronics Radar</title>

<style>

body {
    font-family:
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        "Microsoft YaHei",
        sans-serif;

    max-width: 950px;
    margin: auto;
    padding: 20px;

    line-height: 1.7;

    background: #f5f5f5;
    color: #222;
}

.container {
    background: white;
    padding: 25px;

    border-radius: 14px;
}

h1 {
    margin-bottom: 5px;
}

.subtitle {
    color: #666;
}

.card {
    border: 1px solid #ddd;

    border-radius: 10px;

    padding: 18px;

    margin: 15px 0;
}

.tag {
    display: inline-block;

    padding: 3px 8px;

    margin-right: 5px;

    border-radius: 5px;

    background: #eee;

    font-size: 13px;
}

.date {
    color: #888;

    font-size: 13px;
}

.article {
    border-left: 4px solid #ddd;

    padding-left: 15px;

    margin: 20px 0;
}

.article a {
    color: #333;

    text-decoration: none;
}

.article a:hover {
    text-decoration: underline;
}

#loading {
    color: #777;
}

</style>

</head>


<body>

<div class="container">

<h1>⚡ Power Electronics Radar</h1>

<p class="subtitle">
电力电子前沿技术情报 · AI 自动摘要
</p>

<hr>


<h2>🔥 今日 AI 情报</h2>

<div id="loading">
正在加载最新情报……
</div>


<div id="summary"></div>


<h2>📰 原始信息</h2>

<div id="articles"></div>


<h2>🔬 技术雷达</h2>

<div class="card">

<span class="tag">SST</span>

<span class="tag">SiC</span>

<span class="tag">GaN</span>

<span class="tag">DAB</span>

<span class="tag">CLLC</span>

<span class="tag">GFM</span>

<span class="tag">PCS</span>

<span class="tag">800V DC</span>

<span class="tag">AI Data Center</span>

<span class="tag">高功率密度</span>

<span class="tag">高频磁件</span>

</div>


<p class="date" id="updated"></p>

</div>


<script>

async function loadRadar() {

    try {

        const response =
            await fetch("data.json?" + Date.now());

        const data =
            await response.json();


        document.getElementById("loading")
            .style.display = "none";


        /*
         * AI 总结
         */

        const summary =
            document.getElementById("summary");


        const card =
            document.createElement("div");

        card.className = "card";

        card.innerHTML =
            data.summary
                .replace(/\n/g, "<br>");


        summary.appendChild(card);


        /*
         * 原始文章
         */

        const articles =
            document.getElementById("articles");


        data.articles.forEach(article => {

            const div =
                document.createElement("div");

            div.className =
                "article";


            div.innerHTML = `

                <h3>

                    <a
                        href="${article.link}"
                        target="_blank"
                    >

                        ${article.title}

                    </a>

                </h3>

                <p>
                    ${article.source}
                </p>

            `;


            articles.appendChild(div);

        });


        /*
         * 更新时间
         */

        document.getElementById("updated")
            .textContent =
            "最后更新：" +
            data.updated;


    }

    catch (error) {

        document.getElementById("loading")
            .textContent =
            "加载失败：" + error;

    }

}


loadRadar();

</script>


</body>

</html>
